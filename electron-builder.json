{
  "appId": "sh.omp.gui",
  "productName": "OMP GUI",
  "artifactName": "OMP-GUI-${version}-${arch}.${ext}",
  "electronDist": "node_modules/electron/dist",
  "directories": {
    "output": "release"
  },
  "afterPack": "build/afterPack.cjs",
  "files": [
    "dist-electron",
    "resources"
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      }
    ]
  },
  "win": {
    "target": "nsis"
  },
  "linux": {
    "target": "AppImage"
  }
}
